# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API Keys. Only the publishable key belongs here.
# The secret key never goes in any VITE_ variable (VITE_ values are sent to the browser).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional: Cloudflare Turnstile's site key (TECH_SPEC §9). With it, Log in, Sign up and
# Forgot password show the CAPTCHA; the matching secret goes in Supabase Auth's settings.
# Cloudflare's test key that always passes: 1x00000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=
