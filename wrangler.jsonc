{ "name": "swimclass", "compatibility_date": "2026-09-27",
  // The site has one address: Auth's links and login's CORS (SITE_URL) allow only that origin,
  // so `wrangler deploy` attaches swimclass.online and leaves the workers.dev address off.
  "routes": [{ "pattern": "swimclass.online", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" } }
